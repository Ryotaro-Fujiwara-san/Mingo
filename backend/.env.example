# このファイルを .env にコピーして、自分のキーを入れて使ってください
# .env は .gitignore で除外されるので GitHub には上がりません

# ========================================
# OpenAI API
# Realtime API（会話）/ GPT-5（文法訂正・発音講評・ヒント生成）で使う
# https://platform.openai.com/api-keys
# ========================================
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ========================================
# Azure AI Speech (発音採点。Step 5 で使用。未実装のうちは未設定でOK)
# https://portal.azure.com → Speech サービスを作成
# ========================================
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=japaneast
